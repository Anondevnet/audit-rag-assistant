# Embedder: hashing (offline, deterministic, used in CI),
# ollama (local nomic-embed-text), or auto (ollama if reachable).
AUDIT_RAG_EMBEDDER=auto

# Ollama settings (only used when the embedder is ollama)
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_EMBED_MODEL=nomic-embed-text

# Reranker: flashrank (downloads a small ONNX model on first use),
# token (offline lexical overlap), or none (keep hybrid order).
AUDIT_RAG_RERANKER=token

# Default index path
AUDIT_RAG_INDEX=data/indexes/audit.db

# Generator: extractive (default, deterministic, used in CI) or ollama.
# Ollama chat is used only when AUDIT_RAG_GENERATOR=ollama and OLLAMA_CHAT_MODEL is set.
AUDIT_RAG_GENERATOR=extractive
# OLLAMA_CHAT_MODEL=
